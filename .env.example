# ============================================================
# Smart Money Backend · Variables de entorno
# ============================================================
# Copia este fichero a .env y rellena los valores reales.

# Puerto del servidor (default 8787)
PORT=8787

# --- The Odds API (https://the-odds-api.com/) ---
# Registro gratis: 500 requests/mes en plan free.
# Necesario para cuotas reales en vivo.
ODDS_API_KEY=tu_api_key_aqui

# Región de casas de apuestas: us | eu | uk | au
# eu incluye Pinnacle, Bet365 EU, William Hill, Betway, etc.
ODDS_API_REGION=eu

# Mercados a consultar: h2h (1X2/ML), spreads (handicap), totals (Over/Under)
ODDS_API_MARKETS=h2h,spreads,totals

# Formato de cuotas: decimal | american
ODDS_API_ODDS_FORMAT=decimal

# Bookmakers a incluir (lista separada por comas; vacío = todos los de la región)
# Ejemplo eu: pinnacle,bet365,williamhill,betway,unibet,betclic
# Ejemplo us: draftkings,fanduel,betmgm,pointsbetus
BOOKMAKERS=

# --- Cache ---
# Tiempo de vida del cache en segundos (default 60 = 1 minuto)
CACHE_TTL=60

# --- Histórico (RLM/STEAM) ---
# Carpeta donde se guardan snapshots históricos de cuotas
HISTORICAL_DIR=./data/historical

# Frecuencia de snapshot en segundos (default 600 = 10 min)
SNAPSHOT_INTERVAL=600

# --- CORS ---
# Orígenes permitidos (lista separada por comas; * = cualquiera)
# Para producción, lista solo tus dominios: https://midominio.com,https://app.midominio.com
CORS_ORIGINS=*

# --- Modo DEMO (sin API key real) ---
# Si true, el servidor devuelve datos sintéticos pero coherentes,
# para desarrollo/pruebas sin consumir cuota de The Odds API.
DEMO_MODE=false
